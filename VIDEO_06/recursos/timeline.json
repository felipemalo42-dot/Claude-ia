   "end": 142.314,
   "sents": [
    {
     "text": "Diez: las plataformas.",
     "start": 128.733,
     "end": 130.051,
     "voice": "host"
    },
    {
     "text": "GTA 5 salió en PS3 y Xbox 360, y a PC llegó diecinueve meses después.",
     "start": 130.381,
     "end": 136.505,
     "voice": "host"
    },
    {
     "text": "GTA 6 sale solo en PS5 y Xbox Series, y la versión de PC no tiene fecha.",
