    {
     "text": "El idioma.",
     "start": 143.881,
     "end": 144.702,
     "voice": "host"
    },
    {
     "text": "GTA 5 no tenía doblaje al español y GTA 6 tampoco: voces en inglés y textos en español.",
     "start": 145.032,
     "end": 151.029,
     "voice": "host"
    },
    {
     "text": "Algunos lo celebran por las actuaciones originales; otros, no tanto.",
     "start": 151.359,
     "end": 155.303,
     "voice": "host"
    }
   ],
   "id": "b13"
  },
  {
